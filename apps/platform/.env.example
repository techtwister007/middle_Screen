# Postgres (Supabase in production, local Postgres in development)
DATABASE_URL=postgres://postgres@localhost:5432/salon_dev
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Secret used to sign customer sessions (phone OTP login)
CUSTOMER_SESSION_SECRET=change-me-too
# Root domain used for salon subdomains, e.g. ourbrand.in (glamnails.ourbrand.in)
ROOT_DOMAIN=localhost:3000
PUBLIC_URL=http://localhost:3000
# Vercel Cron secret for /api/payload-jobs/run
CRON_SECRET=
# inline = run event handlers immediately (dev/test); queue = Payload jobs queue (production)
EVENTS_MODE=inline
# Adapters: fake | live
MESSAGING_PROVIDER=fake
PAYMENTS_PROVIDER=fake
IMAGE_AI_PROVIDER=fake
# WhatsApp provider (official BSP) - generic HTTP adapter
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supabase Storage (S3-compatible). Leave empty to store uploads on local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AI image API for try-on
IMAGE_AI_URL=
IMAGE_AI_KEY=

# Development only: fixed login code (ignored when NODE_ENV=production)
OTP_FIXED_CODE=
