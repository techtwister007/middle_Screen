# ---------- Core ----------
APP_URL=http://localhost:3000            # production: https://proppulse.vectorscale.in
APP_ALIAS_HOSTS=                          # old hostnames to redirect after a rename (comma separated)
DATABASE_URL=postgres://pp:pp@localhost:5432/proppulse
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
CRON_SECRET=change-me
DEV_TOOLS=true                            # enables WhatsApp simulator & dev login. false in production

# ---------- Branding (rename the product here) ----------
NEXT_PUBLIC_PRODUCT_NAME=PropPulse
NEXT_PUBLIC_COMPANY_NAME=VectorScale
NEXT_PUBLIC_COMPANY_URL=https://vectorscale.in
NEXT_PUBLIC_SUPPORT_EMAIL=support@vectorscale.in

# ---------- Storage ----------
STORAGE_DRIVER=local                      # local | s3 (Cloudflare R2)
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=                              # https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=proppulse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                            # public bucket URL / custom domain

# ---------- AI (any OpenAI-compatible provider; Groq recommended, free tier) ----------
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=                               # empty = built-in rule-based parser (no AI)
AI_MODEL=llama-3.3-70b-versatile
AI_TRANSCRIBE_MODEL=whisper-large-v3

# ---------- WhatsApp ----------
WA_PROVIDER=console                       # console (simulator) | baileys (test bridge) | chatsync (production)
WA_NUMBER=919999999999                    # bot number, digits only
BRIDGE_SECRET=change-me                   # shared with bridge/baileys
CHATSYNC_API_URL=
CHATSYNC_API_KEY=
CHATSYNC_PHONE_ID=
CHATSYNC_VERIFY_TOKEN=
CHATSYNC_APP_SECRET=

# ---------- Web push (npm run keys:vapid) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vectorscale.in

# ---------- Billing ----------
RAZORPAY_KEY_ID=                          # empty = simulated checkout (dev only)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_ID=vectorscale@upi
UPI_NAME=VectorScale
PLAN_PRICE_INR=500
TRIAL_DAYS=30
GRACE_DAYS=7
PAGES_AFTER_LOCK_DAYS=30
