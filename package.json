{
  "name": "proppulse",
  "version": "0.1.0",
  "private": true,
  "description": "PropPulse by VectorScale — WhatsApp-first property sharing & buyer intelligence for real estate agents",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
