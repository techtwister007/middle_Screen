    "nanoid": "^5.1.6",
    "next": "^15.5.29",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "web-push": "^3.6.7",
