# URL of the running app (local: http://localhost:3000, or your tunnel / production URL)
APP_URL=http://localhost:3000
# Must equal BRIDGE_SECRET in the app's .env
BRIDGE_SECRET=dev-bridge

# --- Safety limits (keep low for a new number; raise slowly after weeks of normal use) ---
MAX_PER_MINUTE=12
MAX_PER_HOUR=150
MAX_PER_DAY=600
# Never message anyone who hasn't written to the bot within this many hours (official API rule)
REPLY_WINDOW_HOURS=24
# After long downtime, ignore messages older than this (avoids a burst of late replies)
IGNORE_OLDER_THAN_HOURS=12
