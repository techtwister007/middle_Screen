{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": [], "env": ["DATABASE_URL", "TEST_DATABASE_URL", "PAYLOAD_SECRET"] }
  }
}
